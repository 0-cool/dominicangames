{
  "name": "sd-open-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DominicanGames — One platform. Multiple worlds. Plataforma de videojuegos hecha en República Dominicana; primer título: Santo Domingo Open World.",
  "workspaces": ["packages/*", "apps/*", "tools/*"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @sd/server\" \"npm run dev -w @sd/web\"",
    "build": "npm run build -w @sd/web && npm run build -w @sd/server",
    "start": "npm run start -w @sd/server",
    "world:build": "npm run build -w @sd/world-builder",
    "db:generate": "npm run db:generate -w @sd/server",
    "db:migrate": "npm run db:migrate -w @sd/server",
    "db:backup": "npm run db:backup -w @sd/server",
    "db:rollback": "npm run db:rollback -w @sd/server --",
    "admin:create": "npm run admin:create -w @sd/server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
