# ───────────── DominicanGames (Santo Domingo Open World): environment (copy to .env) ─────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# PostgreSQL 16+. This default matches docker-compose.yml (`docker compose up -d`), which uses port 55432 so it
# never clashes with another PostgreSQL on your computer. Using your own server? Put its user/password/port here.
DATABASE_URL=postgres://sd:sd_dev_password@127.0.0.1:55432/sd_open_world
# Public origin of the web app (used for CSRF/Origin checks, email links and redirects)
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=false
SESSION_TTL_DAYS=30
# ≥32 random chars — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=change-me-change-me-change-me-change-me-0001

# DG Monetization — DominicanGames is FREE. Keep this off: no checkout, no purchase UI, nothing to pay to play.
# (Turning it on only makes OPTIONAL products configured in code available; see docs/MONETIZATION.md.)
MONETIZATION_ENABLED=false
# Payment provider kept for payments made before the platform became free (late confirmations, refunds):
# sandbox | azul | cardnet. The sandbox page never exists in production.
PAYMENT_PROVIDER=sandbox
SANDBOX_WEBHOOK_SECRET=change-me-sandbox-webhook-secret-000000000001
# A refund of a legacy RD$100 purchase removes the cosmetic “Fundador” badge (the game stays free).
REVOKE_ACCESS_ON_REFUND=true

# AZUL (only when PAYMENT_PROVIDER=azul) — credentials come from AZUL merchant onboarding
AZUL_ENV=test
AZUL_MERCHANT_ID=
AZUL_STORE=
AZUL_CHANNEL=EC
AZUL_AUTH1=
AZUL_AUTH2=
AZUL_CERT_PATH=
AZUL_KEY_PATH=

# Email: SMTP URL (required in production), e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM="DominicanGames <no-reply@example.com>"
# Development only: store emails in the dev mailbox table (GET /api/dev/mailbox)
DEV_MAILBOX=true

# World data produced by `npm run world:build` (served to signed-in DominicanGames players).
# Default: <cwd>/game-data, which is apps/server/game-data when started with `npm run dev|start -w @sd/server`.
# Use an absolute path in production.
# GAME_DATA_DIR=/absolute/path/to/apps/server/game-data
# Production: serve the built SPA from the API process (absolute path recommended)
# WEB_DIST_DIR=/absolute/path/to/apps/web/dist
LOG_LEVEL=info
# Apply pending SQL migrations at boot (set to false if you run `npm run db:migrate` in your deploy step)
MIGRATE_ON_START=true
# Write a JSON backup of every table to backups/ before applying pending migrations (boot and db:migrate)
DB_BACKUP_BEFORE_MIGRATE=true
# BACKUP_DIR=/absolute/path/to/backups
# Multiplies every per-IP rate limit. Keep 1 in production; raise only for local testing / shared NAT.
RATE_LIMIT_SCALE=1
